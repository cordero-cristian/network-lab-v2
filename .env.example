# Local-lab-only credentials. Do not reuse or expose these outside loopback.
COMPOSE_PROJECT_NAME=network-lab
POSTGRES_ADMIN_PASSWORD=lab-postgres-admin
NAUTOBOT_DB_PASSWORD=lab-nautobot-db
TEMPORAL_DB_PASSWORD=lab-temporal-db
REDIS_PASSWORD=lab-redis
NAUTOBOT_SECRET_KEY=local-only-not-for-production-change-me
NAUTOBOT_SUPERUSER_NAME=admin
NAUTOBOT_SUPERUSER_EMAIL=admin@example.com
NAUTOBOT_SUPERUSER_PASSWORD=admin
NAUTOBOT_SUPERUSER_API_TOKEN=0123456789abcdef0123456789abcdef01234567
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw

# Host-facing application ports, all bound to 127.0.0.1 by Compose.
LAB_NAUTOBOT_HOST_PORT=8000
LAB_TEMPORAL_HOST_PORT=7233
LAB_TEMPORAL_UI_HOST_PORT=8080
LAB_KAFKA_HOST_PORT=9092
LAB_UI_API_HOST_PORT=8001
LAB_UI_HOST_PORT=3000

# Host-side validated settings. Kafka defaults from LAB_KAFKA_HOST_PORT.
LAB_NAUTOBOT_URL=http://localhost:8000
LAB_TEMPORAL_ADDRESS=localhost:7233
LAB_TEMPORAL_NAMESPACE=default
LAB_TEMPORAL_UI_URL=http://localhost:8080
LAB_PROBE_TIMEOUT_SECONDS=10
LAB_COMPOSE_PROJECT=network-lab
LAB_RENDER_REQUEST_TOPIC=network.render.requested
LAB_RENDER_COMPLETED_TOPIC=network.render.completed
LAB_RENDER_FAILED_TOPIC=network.render.failed
LAB_DEPLOYMENT_REQUEST_TOPIC=network.deployment.requested
LAB_DEPLOYMENT_COMPLETED_TOPIC=network.deployment.completed
LAB_DEPLOYMENT_FAILED_TOPIC=network.deployment.failed
LAB_RENDER_CONSUMER_GROUP=network-automation-render-consumer
LAB_TEMPORAL_TASK_QUEUE=network-automation

# Read-only control-plane API bounds. Workflow requests have a fixed hard maximum of 50.
LAB_API_PROBE_TIMEOUT_SECONDS=3
LAB_API_OVERVIEW_TIMEOUT_SECONDS=8
LAB_API_OVERVIEW_WORKFLOW_LIMIT=8
LAB_API_WORKFLOW_LIMIT=25
LAB_API_WORKFLOW_HYDRATION_CONCURRENCY=4
LAB_API_LIVE_TIMEOUT_SECONDS=15
LAB_API_DEVICE_LIMIT=50

# Disposable SR Linux lab access. Credentials are optional for render-only startup.
# On canonical netlab acceptance, inject them from generated inventory; do not persist them.
LAB_DEVICE_USERNAME=
LAB_DEVICE_PASSWORD=
LAB_DEVICE_GNMI_PORT=57401
LAB_DEVICE_GNMI_TIMEOUT_SECONDS=10
LAB_DEVICE_GNMI_TLS_MODE=insecure
